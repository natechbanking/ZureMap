{
  "name": "zuremap",
  "version": "0.7.0",
  "description": "Scan your Azure subscriptions and generate interactive architecture diagrams, from the terminal.",
  "keywords": [
    "azure",
    "architecture",
    "diagram",
    "cli",
    "azure-cli",
    "visualization",
    "cloud"
  ],
  "homepage": "https://github.com/natechbanking/ZureMap#readme",
  "bugs": "https://github.com/natechbanking/ZureMap/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natechbanking/ZureMap.git"
  },
  "license": "Elastic-2.0",
  "bin": {
    "zuremap": "bin/zuremap.js"
  },
  "files": [
    "bin/",
    "proxy/",
    "!proxy/**/*.test.js",
    "dist/zuremap/browser/",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently \"node proxy/server.js\" \"ng serve --proxy-config proxy.conf.json\"",
    "build": "ng build",
    "build:demo": "ng build --configuration=demo",
    "build:stats": "ng build --stats-json",
    "build:ci": "npm run build:stats && node scripts/check-bundle-stats.js",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/run-tests.js",
    "test:proxy": "node --test proxy/**/*.test.js",
    "map-icons": "node scripts/map-icons.js",
    "lint": "ng lint",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "escape-html": "^1.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@azure/msal-browser": "^5.28.0",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "^6.0.0",
    "angular-eslint": "^22.6.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "elkjs": "^0.12.1",
    "eslint": "^10.14.0",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "ng-diagram": "^1.4.0",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.4",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "zone.js": "~0.16.3",
    "@eslint/js": "^10.0.1"
  }
}
